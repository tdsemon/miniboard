<!-- no x-cloak: this markup only arrives via htmx swap, and Alpine's mutation
     observer initializes it in a microtask before the next paint (so x-cloak
     can't prevent a flash — it would just outlive notes.js's afterSettle hook
     and leave the textarea display:none when we try to restore the cursor). -->
<div class="notes-backdrop" x-show="open" x-transition.opacity @click="closeIt()"></div>
<aside class="notes-panel" x-show="open" x-transition
    role="dialog" aria-labelledby="notes-title">
    <div class="notes-head">
        <h2 id="notes-title"><%= task.title %></h2>
        <button type="button" class="notes-close" @click="closeIt()" aria-label="Close notes"><%- icon("close-outline") %></button>
    </div>
    <form class="notes-form" onsubmit="return false">
        <!-- rule 5: inline prompt, not a modal. restore is the focused default
             (notes.js focuses .draft-restore once the panel settles). -->
        <div class="draft-bar" x-show="prompt" role="status">
            <span x-show="prompt === 'prompt-restore'">You have a local draft of this note that isn't on the server yet.</span>
            <span x-show="prompt === 'prompt-server-reset'">Server was reset — your local draft is newer than the server's copy.</span>
            <button type="button" class="draft-restore" @click="restoreDraft()"><%- icon("arrow-undo-outline") %>Restore</button>
            <button type="button" class="draft-discard" @click="discardDraft()"><%- icon("trash-outline") %>Discard</button>
        </div>
        <!-- rule 6: one bar for both conflict sources — a 409 mid-save, and an
             open whose local draft is older than the server (step 6's
             keep-with-notice). x-if (not x-show) so the bar mounts fresh and
             the keep-mine focus in the same tick as it appears. server text
             renders with x-text only. -->
        <template x-if="conflict">
            <div class="draft-bar conflict-bar" role="alert">
                <span>this note changed elsewhere (<span x-text="conflictLabel"></span>).</span>
                <button type="button" class="conflict-keep" @click="keepMine()">keep mine</button>
                <button type="button" class="conflict-take" @click="takeServer()">take server</button>
                <button type="button" class="conflict-show" @click="showServer = !showServer"
                    x-text="showServer ? 'hide server text' : 'show server text'"></button>
                <pre class="conflict-server" x-show="showServer" x-text="conflict?.text"></pre>
            </div>
        </template>

        <label class="sr-only" for="note-<%= task.id %>">Note for <%= task.title %></label>
        <!-- readonly while a prompt/conflict is up: typing would overwrite the
             draft the prompt is about, or race the conflict we just lost -->
        <textarea class="notes-textarea" id="note-<%= task.id %>" name="note"
            placeholder="Write a note..."
            :readonly="!!prompt || status === 'conflict'"
            hx-post="/tasks/<%= task.id %>/notes"
            hx-trigger="input changed delay:800ms, save-now from:closest form"
            hx-target="#note-status-swap"
            hx-swap="innerHTML"
            hx-sync="closest form:queue last"
            @input="onInput()"
            @focus="onFocus()"><%= note.note %></textarea>
        <input type="hidden" id="note-version" name="version" value="<%= note.version %>"
            data-updated-at="<%= note.updatedAt ?? "" %>">
        <div class="notes-foot">
            <button type="button" class="notes-save"
                hx-post="/tasks/<%= task.id %>/notes"
                hx-target="#note-status-swap"
                hx-swap="innerHTML"
                hx-trigger="click"
                hx-sync="closest form:queue last">Save</button>
            <button type="button" class="notes-retry" x-show="status === 'error'"
                @click="retry()"><%- icon("reload-outline") %>Retry</button>
            <div class="note-status" aria-live="polite">
                <span x-show="status === 'editing'">editing…</span>
                <span x-show="status === 'dirty'">unsaved changes</span>
                <span x-show="status === 'saving'"><span class="sync-spin" aria-hidden="true"><%- icon("sync-outline") %></span>saving…</span>
                <span x-show="status === 'saved'"><%- icon("cloud-done-outline") %><span x-text="savedLabel"></span></span>
                <span x-show="status === 'error'"><%- icon("alert-circle-outline") %>save failed</span>
                <!-- server swaps land here: OOB version input does the real work,
                     this div stays empty so Alpine keeps the visible labels -->
                <div id="note-status-swap"></div>
            </div>
        </div>
        <!-- "take server" lands the /notes/current fragment here; the div is
             hidden, notes.js reads it back out with textContent -->
        <div id="note-current-swap" hidden></div>
    </form>
</aside>
