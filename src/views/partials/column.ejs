<section class="column" id="column-<%= col.key %>" tabindex="-1"<% if (locals.oob) { %> hx-swap-oob="true"<% } %>>
    <div class="column-head">
        <span class="dot dot-<%= col.key %>"></span>
        <h2>
            <%= col.label %>
        </h2>
        <span class="count">
            <%= tasks.filter(t=> t.status === col.key).length %>
        </span>
    </div>

    <div class="cards" id="col-<%= col.key %>" x-sortable>
        <% tasks.filter(t=> t.status === col.key).sort((a, b) => a.order - b.order).forEach(task => { %>
            <!-- unescaped output so the card markup renders as HTML -->
            <%- include("card", {task, columns}) %>
                <%}) %>
    </div>
    <%# hidden by default; CSS reveals it only when .cards has no .card %>
    <%- include("empty-state", {kind: "column", message: "nothing here yet, drag a task in or add one"}) %>

    <% if(col.key === "planned") {%>
        <div class="add-wrap" x-data="{adding: false}">
            <button class="add-btn" x-show="!adding" @click="adding = true">+ Add Task</button>

            <form class="add-form" x-show="adding"
                hx-post="/tasks"
                hx-target="#col-planned"
                hx-swap="beforeend"
                @htmx:after-request="$el.reset()"
            >
                <input name="title" placeholder="Task title" required autofocus>
                <input type="hidden" name="status" value="planned">
                <input type="hidden" name="boardId" value="<%= boardId %>">
                <button type="submit">Add</button>
            </form>

        </div>
    <% } %>
</section>
