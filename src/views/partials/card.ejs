<% const keys = columns.map((c) => c.key); %>
<% const next = keys[Math.min(keys.indexOf(task.status) + 1, keys.length - 1)]; %>
<div class="card" id="card-<%= task.id %>">
    <p class="card-title"><%= task.title %></p>
    <div class="card-action">
        <button class="chip" title="move right" hx-post="/tasks/<%= task.id %>/move" hx-target="#column-<%= next %>" hx-swap="outerHTML">→</button>
        <button class="chip-danger" title="Delete" hx-delete="/tasks/<%= task.id %>" hx-target="#column-<%= task.status %>" hx-swap="outerHTML" hx-confirm="Delete this task?">X</button>
    </div>
</div>
