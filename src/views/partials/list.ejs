<%- include("banner") %>
<div class="task-list">
    <% columns.forEach((col) => { %>
        <section class="list-group" id="list-<%= col.key %>">
            <h2 class="list-head"><span class="dot dot-<%= col.key %>"></span><%= col.label %>
                <span class="count"><%= tasks.filter((t) => t.status === col.key).length %></span></h2>
            <% tasks.filter((t) => t.status === col.key).sort((a, b) => a.order - b.order).forEach((task) => { %>
                <div class="list-row" id="row-<%= task.id %>" data-task-id="<%= task.id %>" data-board-id="<%= task.boardId %>">
                    <span class="card-title task-title list-title"><%= task.title %></span>
                    <% if (task.note) { %><span class="note-dot list-note" title="Has a note"></span><% } %>
                    <%- include("move-select", {task, columns, target: "#board", swap: "innerHTML", view, sort, dir}) %>
                    <button class="notes-btn" id="notes-btn-<%= task.id %>" title="Note" aria-label="Note on <%= task.title %>"
                        @click="$dispatch('notes-open', { id: <%= task.id %> })"><%- icon("document-text-outline") %></button>
                    <button title="Delete" aria-label="Delete task <%= task.title %>" hx-delete="/tasks/<%= task.id %>" hx-target="#board" hx-swap="innerHTML"
                        hx-vals='js:({view: "<%= view %>", sort: "<%= sort %>", dir: "<%= dir %>", q: document.querySelector(".search")?.value ?? ""})'
                        hx-confirm="Delete this task?"
                        @htmx:after-request="if ($event.detail.successful && $store.notes.openId === <%= task.id %>) $dispatch('notes-close-force')"><%- icon("trash-outline") %></button>
                </div>
            <% }) %>
        </section>
    <% }) %>
    <% if (!tasks.length) { %>
        <% if (q) { %>
            <%- include("empty-state", {kind: "search", message: `no tasks match “${q}”`, action: "clear search", actionAttr: `@click="document.querySelector('.search').value = ''; $store.mb.refresh()"`}) %>
        <% } else { %>
            <%- include("empty-state", {kind: "list", message: "no tasks on this board yet"}) %>
        <% } %>
    <% } %>
</div>
