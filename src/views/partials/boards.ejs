<!-- Sidebar board list: swapped wholesale by htmx (load, add, rename, delete).
     The active marker reads the persisted Alpine store, so a swap can't lose
     which board is open. data-removed-task-ids only rides on the delete
     response so the client can drop those tasks' drafts. -->
<nav id="boards" class="projects"<% if (locals.removedTaskIds) { %> data-removed-task-ids="<%= removedTaskIds %>"<% } %>>
    <% boards.forEach((b) => { %>
        <div class="project-item">
            <button type="button" class="project-btn" data-board-id="<%= b.id %>"
                x-show="editingId !== <%= b.id %>"
                :class="$store.mb.ui.activeBoardId === <%= b.id %> && 'active'"
                @click="pickBoard(<%= b.id %>)"
                @dblclick="startRename(<%= b.id %>)"><%= b.name %></button>
            <template x-if="editingId === <%= b.id %>">
                <form class="board-rename" @submit.prevent="submitRename(<%= b.id %>)">
                    <input name="name" value="<%= b.name %>" aria-label="board name" maxlength="40"
                        x-init="$nextTick(() => { if (renameDraft != null) $el.value = renameDraft; $el.focus(); $el.select(); })"
                        @input="renameDraft = $event.target.value"
                        @keydown.enter.prevent="submitRename(<%= b.id %>)"
                        @keydown.escape.stop.prevent="cancelRename(true)">
                    <button type="submit">Save</button>
                    <p class="rename-error" x-show="renameError" x-cloak x-text="renameError" role="alert"></p>
                </form>
            </template>
            <% if (boards.length > 1) { %>
                <!-- pencil: same startRename() code path as the name dblclick; opacity
                     reveal but stays tabbable; coarse pointers get it permanently -->
                <button type="button" class="project-edit" data-rename-btn="<%= b.id %>"
                    title="Rename board" aria-label="rename <%= b.name %>"
                    @click="startRename(<%= b.id %>)"><%- icon("pencil-outline") %></button>
                <!-- last board is the app: no delete button, and the route 400s as a backstop -->
                <button type="button" class="project-x" title="Delete board" aria-label="Delete board <%= b.name %>"
                    hx-delete="/boards/<%= b.id %>" hx-target="#boards" hx-swap="outerHTML"
                    hx-confirm="Delete this board and all its tasks?"><%- icon("trash-outline") %></button>
            <% } %>
        </div>
    <% }) %>
    <form class="board-add" hx-post="/boards" hx-target="#boards" hx-swap="outerHTML" @htmx:after-request="$el.reset()">
        <input name="name" placeholder="+ New board" required maxlength="60">
    </form>
</nav>
