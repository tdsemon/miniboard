
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Miniboard</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="stylesheet" href="/style.css">
    <!-- vendored: pinned copies in /public/vendor, served by express.static
         (no CDN — jsdelivr started serving these as text/plain/nosniff). -->
    <script src="/vendor/htmx.min.js"></script>
    <script src="/vendor/Sortable.min.js"></script>
    <script src="/dnd.js"></script>
    <!-- notes.js listens on alpine:initializing, which Alpine fires after the
         persist plugin's alpine:init handler, so tag order here is not
         load-bearing — but keep these as defer/module scripts so they run
         before Alpine's start(). -->
    <script defer src="/vendor/alpine-persist.min.js"></script>
    <script type="module" src="/notes.js"></script>
    <script defer src="/vendor/alpine.min.js"></script>

</head>
<body>


   <!-- One Alpine object owns the shell: sidebar, the current view/board, and
        the rename-in-progress id. Every board/view re-render goes through
        $store.mb.refresh() (notes.js) so the URL always reflects the store;
        htmx owns the request and the swap. -->
   <div class="app" x-data="{
        sidebarOpen: true,
        editingId: null,
        setView(v) { const ui = this.$store.mb.ui; if (ui.view !== v) { ui.view = v; this.$store.mb.refresh(); } },
        pickBoard(id) { const ui = this.$store.mb.ui; if (ui.activeBoardId !== id) { ui.activeBoardId = id; this.$store.mb.refresh(); } },
    }" x-init="$store.mb.refresh()">
    <aside class="sidebar" x-show="sidebarOpen">
        <div class="brand">Miniboard</div>
        <!-- filled by GET /boards on load; every add/rename/delete re-swaps it -->
        <nav id="boards" class="projects" hx-get="/boards" hx-trigger="load" hx-swap="outerHTML"></nav>
    </aside>

    <main class="main">
        <header class="topbar">
            <button class="icon-btn" @click="sidebarOpen = !sidebarOpen">☰</button>
            <div class="tabs">
                <button :class="$store.mb.ui.view === 'board' && 'active'" @click="setView('board')">Board</button>
                <button :class="$store.mb.ui.view === 'table' && 'active'" @click="setView('table')">Table</button>
                <button :class="$store.mb.ui.view === 'list' && 'active'" @click="setView('list')">List</button>
            </div>

            <input class="search" type="search" name="q" placeholder="Search task..."
                @input.debounce.300ms="$store.mb.refresh()">

        </header>

        <div id="move-status" class="sr-only" role="status" aria-live="polite"></div>

        <!-- board, table and list all render into this one element -->
        <div id="board" class="board-wrap">
            <span>Loading board......</span>
        </div>

    </main>

   </div> 

   <!-- Notes drawer: outside #board so column swaps and the failure re-sync never touch it.
        Alpine (notesDrawer) owns the status machine; htmx owns every request. -->
   <div id="notes-drawer"
       x-data="notesDrawer()"
       @notes-open.window="onOpen($event.detail.id, $event.detail.resume)"
       @notes-close.window="closeIt()"
       @notes-close-force.window="forceClose()"
       @keydown.escape.window="open && closeIt()"
       @htmx:before-request="onBeforeRequest($event)"
       @htmx:after-request="onAfterRequest($event)"
       @htmx:afterSettle.window="onAfterSettle($event)"
       @htmx:response-error="onError($event)"
       @htmx:send-error="onError($event)"
       @beforeunload.window="onBeforeUnload($event)">
   </div>
    
    
</body>
</html>