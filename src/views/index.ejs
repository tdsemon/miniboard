
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" content="#ffffff">
    <!-- no-flash: apply a stored theme before the stylesheet and first paint.
         No stored value = follow the OS (color-scheme + light-dark() decide);
         an invalid stored value is ignored and cleared. -->
    <script>
        (function () {
            try {
                var stored = localStorage.getItem("miniboard:theme");
                if (stored === "light" || stored === "dark") {
                    document.documentElement.dataset.theme = stored;
                    document.querySelector('meta[name="theme-color"]').content =
                        stored === "dark" ? "#0f1117" : "#ffffff";
                } else {
                    if (stored !== null) localStorage.removeItem("miniboard:theme");
                    document.querySelector('meta[name="theme-color"]').content =
                        matchMedia("(prefers-color-scheme: dark)").matches ? "#0f1117" : "#ffffff";
                }
            } catch (e) { /* storage blocked: system theme, nothing to flash */ }
        })();
    </script>
    <title>Miniboard</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="stylesheet" href="/style.css">
    <!-- vendored: pinned copies in /public/vendor, served by express.static
         (no CDN — jsdelivr started serving these as text/plain/nosniff). -->
    <script src="/vendor/htmx.min.js"></script>
    <script src="/vendor/Sortable.min.js"></script>
    <script src="/dnd.js"></script>
    <!-- notes.js and theme.js listen on alpine:initializing, which Alpine fires
         after the persist plugin's alpine:init handler, so tag order here is not
         load-bearing — but keep these as defer/module scripts so they run
         before Alpine's start(). -->
    <script defer src="/vendor/alpine-persist.min.js"></script>
    <script defer src="/theme.js"></script>
    <script type="module" src="/notes.js"></script>
    <script defer src="/vendor/alpine.min.js"></script>

</head>
<body>


   <!-- One Alpine object owns the shell: sidebar layout mode, the current
        view/board, and the rename-in-progress id. Every board/view re-render
        goes through $store.mb.refresh() (notes.js) so the URL always reflects
        the store; htmx owns the request and the swap.
        Layout has two modes driven by one source of truth (a matchMedia
        listener, no reload): "docked" at >=1024 (a permanent column the menu
        button collapses; the collapsed state is persisted as
        $store.mb.ui.sidebarDocked) and "drawer" below (an off-canvas overlay,
        always closed on load and on every crossing into drawer mode, never
        persisted). -->
   <div class="app" x-data="{
        layout: &quot;docked&quot;,
        drawerOpen: false,
        _mq: null,
        get sidebarDocked() { return this.$store.mb.ui.sidebarDocked; },
        set sidebarDocked(v) { this.$store.mb.ui.sidebarDocked = v; },
        get sidebarOpen() { return this.layout === &quot;docked&quot; ? this.sidebarDocked : this.drawerOpen; },
        set sidebarOpen(v) {
            if (this.layout === &quot;docked&quot;) this.sidebarDocked = v;
            else this.drawerOpen = v;
        },
        applyLayout(mode) {
            if (this.layout === mode) return;
            const wasDrawer = this.layout === &quot;drawer&quot;;
            this.layout = mode;
            if (mode === &quot;drawer&quot;) {
                // drawer is never persisted: always closed when we cross in
                this.drawerOpen = false;
                document.documentElement.classList.remove(&quot;nav-locked&quot;);
            } else if (wasDrawer) {
                // drop the drawer state; docked reads the persisted flag
                this.drawerOpen = false;
                document.documentElement.classList.remove(&quot;nav-locked&quot;);
            }
        },
        editingId: null,
        fadedFor: null,
        setView(v) { const ui = this.$store.mb.ui; if (ui.view !== v) { ui.view = v; this.$store.mb.refresh(); } },
        pickBoard(id) {
            const ui = this.$store.mb.ui;
            if (ui.activeBoardId !== id) {
                ui.activeBoardId = id;
                this.$store.mb.refresh();
                if (this.layout === &quot;drawer&quot;) this.closeSidebar(); // switch closes the drawer
            }
        },
        toggleSidebar() {
            this.sidebarOpen = !this.sidebarOpen;
            // drawer only: lock page scroll and move focus into the drawer.
            // (docked mode has no backdrop and no scroll lock.)
            if (this.layout === &quot;drawer&quot;) {
                document.documentElement.classList.toggle(&quot;nav-locked&quot;, this.drawerOpen);
                if (this.drawerOpen) {
                    // wait out the slide: $nextTick still leaves the drawer
                    // mid-transition (off-screen), and the browser won't focus
                    // an element whose rect is off-screen.
                    this.$nextTick(() =&gt; setTimeout(() =&gt; this.$el.querySelector(&quot;.sidebar-close&quot;)?.focus(), 200));
                }
            }
        },
        closeSidebar() {
            if (this.layout === &quot;drawer&quot; &amp;&amp; !this.drawerOpen) return;
            this.sidebarOpen = false;
            // backdrop/close-button/Escape all land here: unlock + refocus menu
            document.documentElement.classList.remove(&quot;nav-locked&quot;);
            this.$nextTick(() =&gt; setTimeout(() =&gt; this.$el.querySelector(&quot;.menu-btn&quot;)?.focus(), 200));
        },
        // --- board rename: one code path for the pencil click and the name dblclick.
        // editingId lives here on .app (NOT inside #boards), so an htmx swap of the
        // sidebar can't wipe it and Alpine re-renders the rename form after a swap.
        renameError: null,
        renameDraft: null,   // typed-but-unsaved value, kept across a #boards swap
        _renameOutside: null,
        startRename(id) {
            if (this._renameOutside) { document.removeEventListener('pointerdown', this._renameOutside); this._renameOutside = null; }
            this.editingId = id;
            this.renameError = null;
            this.renameDraft = null;
            // close on the NEXT outside pointerdown — attached after this opening
            // click's own pointerdown has already fired, so it can't self-close
            this._renameOutside = (e) => {
                if (this.editingId == null) return;
                if (e.target.closest('.board-rename') || e.target.closest('[data-rename-btn]')) return;
                this.cancelRename(false);
            };
            this.$nextTick(() => document.addEventListener('pointerdown', this._renameOutside));
        },
        cancelRename(refocus) {
            const id = this.editingId;
            this.editingId = null;
            this.renameError = null;
            this.renameDraft = null;
            if (this._renameOutside) { document.removeEventListener('pointerdown', this._renameOutside); this._renameOutside = null; }
            if (refocus && id != null) this.$nextTick(() => document.querySelector('[data-rename-btn=&quot;' + id + '&quot;]')?.focus());
        },
        submitRename(id) {
            const input = document.querySelector('.board-rename input');
            const name = (input?.value ?? '').trim();
            if (!name) { this.renameError = &quot;Board name can&apos;t be empty&quot;; input?.focus(); return; }
            if (name.length > 40) { this.renameError = &quot;Board name is too long (max 40 characters)&quot;; input?.focus(); return; }
            this.renameError = null;
            // close only on a real 2xx; a 400/404 keeps the form open with a message
            const onDone = (evt) => {
                if (evt.detail?.pathInfo?.requestPath !== `/boards/${id}`) return;
                document.removeEventListener('htmx:afterRequest', onDone);
                const status = evt.detail?.xhr?.status ?? 0;
                if (status >= 200 && status < 300) this.cancelRename(true);
                else this.renameError = &quot;Couldn&apos;t rename the board. Try again.&quot;;
            };
            document.addEventListener('htmx:afterRequest', onDone);
            htmx.ajax('POST', `/boards/${id}`, { values: { name }, target: '#boards', swap: 'outerHTML' });
        },
        init() {
            // one source of truth for the layout mode: a live matchMedia
            // listener, no reload. Seeded here so SSR markup and the store
            // agree before Alpine finishes wiring.
            this._mq = window.matchMedia(&quot;(min-width: 1024px)&quot;);
            this._mqSync = () => this.applyLayout(this._mq.matches ? &quot;docked&quot; : &quot;drawer&quot;);
            this._mqSync();
            this._mq.addEventListener(&quot;change&quot;, this._mqSync);
            // drawer is never persisted: always closed on a fresh load
            this.drawerOpen = false;
            document.documentElement.classList.remove(&quot;nav-locked&quot;);
            this.$store.mb.refresh();
            // fade the view root on first paint and view switches only — card
            // moves and search swaps keep the same view name, so they never
            // replay the animation (class add forces a restart when it does)
            window.addEventListener(&quot;htmx:afterSettle&quot;, () => {
                const view = this.$store.mb.ui.view;
                if (view === this.fadedFor) return;
                this.fadedFor = view;
                const board = document.getElementById(&quot;board&quot;);
                board.classList.remove(&quot;view-enter&quot;);
                void board.offsetWidth;
                board.classList.add(&quot;view-enter&quot;);
            });
        },
        destroy() { this._mq?.removeEventListener(&quot;change&quot;, this._mqSync); },
    }" @keydown.escape.window="if (drawerOpen) closeSidebar()"
        :class="drawerOpen ? 'drawer-open' : ''">
    <!-- inert/aria-hidden when the drawer is closed (off-canvas transform
         alone would keep it focusable). Docked mode never sets inert — the
         sidebar is a permanent column there, open or collapsed. -->
    <aside class="sidebar" :data-open="sidebarOpen ? 'true' : 'false'"
        :inert="layout === 'drawer' && !drawerOpen" :aria-hidden="layout === 'drawer' && !drawerOpen" aria-label="Boards">
        <div class="sidebar-head">
            <div class="brand">Miniboard</div>
            <!-- drawer-only close control; CSS hides it in docked mode -->
            <button type="button" class="icon-btn sidebar-close" @click="closeSidebar()"
                aria-label="close sidebar" x-show="layout === 'drawer'" x-cloak>✕</button>
        </div>
        <!-- filled by GET /boards on load; every add/rename/delete re-swaps it -->
        <nav id="boards" class="projects" hx-get="/boards" hx-trigger="load" hx-swap="outerHTML"></nav>
    </aside>
    <div class="sidebar-backdrop" aria-hidden="true"
        :data-open="sidebarOpen ? 'true' : 'false'" @click="closeSidebar()"></div>

    <main class="main">
        <header class="topbar">
            <button type="button" class="icon-btn menu-btn" @click="toggleSidebar()"
                aria-label="Toggle boards sidebar" :aria-expanded="sidebarOpen ? 'true' : 'false'">☰</button>
            <span class="topbar-title" x-data="{
                    name: '',
                    sync() {
                        const id = this.$store.mb.ui.activeBoardId;
                        this.name = document.querySelector('#boards [data-board-id=&quot;' + id + '&quot;]')?.textContent?.trim() ?? '';
                    },
                    init() { this.sync(); window.addEventListener('htmx:afterSettle', () => this.sync()); },
                }" x-text="name"></span>
            <div class="tabs">
                <button :class="$store.mb.ui.view === 'board' && 'active'" @click="setView('board')">Board</button>
                <button :class="$store.mb.ui.view === 'table' && 'active'" @click="setView('table')">Table</button>
                <button :class="$store.mb.ui.view === 'list' && 'active'" @click="setView('list')">List</button>
            </div>

            <!-- search: inline >=640; below that an icon expands the input
                 (value is kept, so a collapsed search still filters) -->
            <div class="search-wrap" x-data="{
                    open: false,
                    wide: window.matchMedia('(min-width: 640px)').matches,
                    init() {
                        const mq = window.matchMedia('(min-width: 640px)');
                        mq.addEventListener('change', (e) => { this.wide = e.matches; if (e.matches) this.open = false; });
                    },
                }">
                <button type="button" class="icon-btn search-btn" aria-label="Search tasks" x-show="!wide"
                    @click="open = !open; if (open) $nextTick(() => $refs.q.focus())">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                        <circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.3-4.3"></path>
                    </svg>
                </button>
                <input class="search" type="search" name="q" placeholder="Search task..." x-ref="q" x-show="open || wide"
                    @input.debounce.300ms="$store.mb.refresh()"
                    @keydown.escape="open = false">
            </div>

            <!-- primary theme control: 44px, aria-pressed reflects effective
                 theme, click animates via startViewTransition in theme.js -->
            <button type="button" class="icon-btn theme-toggle" id="theme-toggle"
                @click="$store.theme.toggle($el)"
                :aria-pressed="$store.theme.effective === 'dark' ? 'true' : 'false'"
                :aria-label="$store.theme.effective === 'dark' ? 'switch to light theme' : 'switch to dark theme'">
                <svg x-show="$store.theme.effective !== 'dark'" x-cloak viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="4"></circle>
                    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
                </svg>
                <svg x-show="$store.theme.effective === 'dark'" x-cloak viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                </svg>
            </button>

        </header>

        <div id="move-status" class="sr-only" role="status" aria-live="polite"></div>

        <!-- board, table and list all render into this one element -->
        <div id="board" class="board-wrap">
            <span>Loading board......</span>
        </div>

    </main>

   </div> 

   <!-- Notes drawer: outside #board so column swaps and the failure re-sync never touch it.
        Alpine (notesDrawer) owns the status machine; htmx owns every request. -->
   <div id="notes-drawer"
       x-data="notesDrawer()"
       @notes-open.window="onOpen($event.detail.id, $event.detail.resume)"
       @notes-close.window="closeIt()"
       @notes-close-force.window="forceClose()"
       @keydown.escape.window="open && closeIt()"
       @htmx:before-request="onBeforeRequest($event)"
       @htmx:after-request="onAfterRequest($event)"
       @htmx:afterSettle.window="onAfterSettle($event)"
       @htmx:response-error="onError($event)"
       @htmx:send-error="onError($event)"
       @beforeunload.window="onBeforeUnload($event)">
   </div>
    
    
</body>
</html>